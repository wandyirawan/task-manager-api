# Application configuration template.
# Copy to .env and override values as needed.

PORT=8080
ENV=dev
JWT_SECRET=change-me
# PostgreSQL connection string (used by the api service). Host is the
# compose service name `db` when running via docker compose.
DB_URL=postgres://tm_user:tm_pass@db:5432/tmapi?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=10
